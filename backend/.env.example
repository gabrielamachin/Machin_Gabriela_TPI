# Copiar este archivo a ".env" y completar los valores.

# PostgreSQL (desarrollo local también se acepta SQLite: sqlite:///./foodstore.db)
DATABASE_URL=postgresql://user:pass@localhost:5432/foodstore_db

# Firma del JWT, mínimo 32 caracteres. Generar una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambiar-esta-clave-de-al-menos-32-caracteres

ALGORITHM=HS256

# Expiración del token y de la cookie, en minutos
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Origen permitido en CORS (frontend Vite)
FRONTEND_ORIGIN=http://localhost:5173

# Cookie "Secure": dejar en false en desarrollo (http) y poner true si se sirve por https
COOKIE_SECURE=false
